{
  "manifest_version": 3,
  "name": "Local API Mock",
  "version": "0.1.0",
  "description": "Locally modify API requests and mock API responses for development.",
  "permissions": ["storage"],
  "host_permissions": ["http://*/*", "https://*/*", "file://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Local API Mock" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file://*/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*", "file://*/*"],
      "js": ["rules.js", "page-interceptor.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
